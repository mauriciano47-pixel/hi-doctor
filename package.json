{
  "name": "hi-doctor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test tests/**/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test tests/clinicalPharmacology.test.js tests/monetizationContracts.test.js tests/pediatricTriage.test.js tests/runtimeContracts.test.js tests/propertyFuzzing.test.js tests/chaosEngineering.test.js",
    "test:mutation": "node ./scripts/mutation-audit.mjs",
    "typecheck": "node -e \"process.exit(0)\"",
    "deploy": "vite build && gh-pages -d dist",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepush": "node ./scripts/pre-push-gate.mjs"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.40.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.1.1",
    "globals": "^17.6.0",
    "vite": "^8.3.4"
  }
}
